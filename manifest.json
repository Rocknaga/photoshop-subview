{
  "manifestVersion": 5,
  "id": "com.rocknaga.subview",
  "name": "サブビュー",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "25.0.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "subview",
      "label": { "default": "サブビュー" },
      "minimumSize": { "width": 230, "height": 260 },
      "maximumSize": { "width": 2400, "height": 2400 },
      "preferredDockedSize": { "width": 300, "height": 480 },
      "preferredFloatingSize": { "width": 380, "height": 560 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium"] },
        { "width": 23, "height": 23, "path": "icons/panel-light.png", "scale": [1, 2], "theme": ["lightest", "light"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
